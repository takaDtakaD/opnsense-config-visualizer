<?xml version="1.0"?>
<opnsense>
  <system>
    <optimization>normal</optimization>
    <hostname>opnsense</hostname>
    <domain>lab.local</domain>
    <timezone>Asia/Tokyo</timezone>
    <dnsserver>192.168.1.1</dnsserver>
    <dnsserver>1.1.1.1</dnsserver>
  </system>
  <interfaces>
    <wan>
      <if>vtnet0</if>
      <ipaddr>dhcp</ipaddr>
      <subnet>24</subnet>
      <gateway>WAN_DHCP</gateway>
      <descr>WAN (home LAN)</descr>
    </wan>
    <lan>
      <if>vtnet1</if>
      <ipaddr>10.10.0.1</ipaddr>
      <subnet>24</subnet>
      <descr>LAB</descr>
    </lan>
    <opt1>
      <if>vtnet2</if>
      <ipaddr>10.20.0.1</ipaddr>
      <subnet>24</subnet>
      <descr>ATTACK</descr>
    </opt1>
  </interfaces>
  <vlans>
    <vlan>
      <if>vtnet1</if>
      <tag>30</tag>
      <pcp>0</pcp>
      <descr>IOT</descr>
    </vlan>
  </vlans>
  <gateways>
    <gateway_item>
      <interface>wan</interface>
      <gateway>192.168.1.1</gateway>
      <name>WAN_DHCP</name>
      <descr>Interface WAN_DHCP Gateway</descr>
    </gateway_item>
  </gateways>
  <aliases>
    <alias>
      <name>LAB_NETS</name>
      <type>network</type>
      <content>10.10.0.0/16</content>
      <descr>lab networks</descr>
    </alias>
    <alias>
      <name>ATTACK_NET</name>
      <type>network</type>
      <content>10.20.0.0/24</content>
      <descr>attack segment</descr>
    </alias>
    <alias>
      <name>HOME_LAN</name>
      <type>network</type>
      <content>192.168.1.0/24</content>
      <descr>home network</descr>
    </alias>
  </aliases>
  <filter>
    <rule>
      <type>pass</type>
      <interface>wan</interface>
      <ipprotocol>inet</ipprotocol>
      <protocol>TCP</protocol>
      <source><network>wan</network></source>
      <destination><network>(self)</network><port>443</port></destination>
      <descr>GUI access from home LAN</descr>
      <direction>in</direction>
      <quick>1</quick>
    </rule>
    <rule>
      <type>pass</type>
      <interface>lan</interface>
      <ipprotocol>inet</ipprotocol>
      <protocol>any</protocol>
      <source><network>lan</network></source>
      <destination><any/></destination>
      <descr>Default allow LAN to any rule</descr>
      <direction>in</direction>
      <quick>1</quick>
    </rule>
    <rule>
      <type>pass</type>
      <interface>lan</interface>
      <ipprotocol>inet</ipprotocol>
      <protocol>any</protocol>
      <source><network>lan</network></source>
      <destination><network>opt1</network></destination>
      <descr>LAB to ATTACK for detonation</descr>
      <direction>in</direction>
      <quick>1</quick>
      <disabled>1</disabled>
    </rule>
    <rule>
      <type>pass</type>
      <interface>opt1</interface>
      <ipprotocol>inet</ipprotocol>
      <protocol>any</protocol>
      <source><network>opt1</network></source>
      <destination><network>lan</network></destination>
      <descr>ATTACK to LAB only</descr>
      <direction>in</direction>
      <quick>1</quick>
      <log>1</log>
    </rule>
    <rule>
      <type>block</type>
      <interface>opt1</interface>
      <floating>yes</floating>
      <direction>in</direction>
      <ipprotocol>inet</ipprotocol>
      <protocol>any</protocol>
      <source><network>opt1</network></source>
      <destination><address>192.168.1.0/24</address></destination>
      <descr>Block ATTACK to home LAN</descr>
      <quick>1</quick>
      <log>1</log>
    </rule>
  </filter>
  <nat>
    <outbound>
      <mode>manual</mode>
      <rule>
        <interface>wan</interface>
        <source><network>10.10.0.0/16</network></source>
        <destination><any/></destination>
        <target>interface</target>
        <descr>NAT lab networks only</descr>
      </rule>
    </outbound>
    <rule>
      <interface>wan</interface>
      <protocol>tcp</protocol>
      <dstport>8443</dstport>
      <target>10.10.0.10</target>
      <local-port>443</local-port>
      <descr>example port forward</descr>
    </rule>
  </nat>
  <dhcpd>
    <lan>
      <enable>1</enable>
      <range><from>10.10.10.100</from><to>10.10.10.200</to></range>
    </lan>
    <opt1>
      <range><from>10.20.0.100</from><to>10.20.0.200</to></range>
    </opt1>
  </dhcpd>
  <OPNsense>
    <version>26.1</version>
  </OPNsense>
</opnsense>
